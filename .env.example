# Copy to .env and fill in real values. .env is gitignored; never commit it.
# Used by docker-compose.yml and by the dev profile (application-dev.yml).

# Local development database (the dev profile connects to this)
DB_URL=jdbc:postgresql://localhost:5432/wms
DB_USERNAME=postgres
DB_PASSWORD=change-me

# pgAdmin login (docker compose only)
PGADMIN_EMAIL=admin@wms.com
PGADMIN_PASSWORD=change-me
